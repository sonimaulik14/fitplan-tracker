# Copy to .env and fill in. Never commit your real .env.

# --- Database (PostgreSQL, e.g. Neon) ---
# Pooled connection (Neon's "-pooler" host) — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Direct connection (non-pooled host) — used for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# --- Auth (REQUIRED) ---
# Session signing secret — generate with: openssl rand -hex 32
# Production refuses to start without this.
AUTH_SECRET=""

# --- Email (optional: powers password-reset emails) ---
# Without these, reset links are logged server-side instead of emailed.
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=""
# Verified sender. "Vajra <onboarding@resend.dev>" works for testing (delivers
# only to your own Resend account email); use your own domain for real sending.
EMAIL_FROM="Vajra <onboarding@resend.dev>"

# --- Web Push (REQUIRED for reminder notifications) ---
# Generate a keypair once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# Same value as VAPID_PUBLIC_KEY — exposed to the browser to subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# Shared secret the reminder cron must send (Authorization: Bearer <secret>).
# Generate with: openssl rand -hex 24
CRON_SECRET=""

# --- Optional: scale infrastructure (the app works without these) ---
# Upstash Redis → shared rate limiting across serverless instances.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Vercel Blob → store avatars/progress photos as URLs instead of inline in the DB.
BLOB_READ_WRITE_TOKEN=""

# --- Optional: live photography. Add EITHER one and refresh photos from Account. ---
# Pexels (instant key, no review): https://www.pexels.com/api/
PEXELS_API_KEY=""
# Unsplash (Demo mode works immediately): https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=""

# Optional: per-exercise demo clips. RapidAPI ExerciseDB:
# https://rapidapi.com/justin-WFnsXH_t6/api/exercisedb
EXERCISEDB_API_KEY=""
