generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (e.g. Neon's -pooler host) for the app at runtime.
  url       = env("DATABASE_URL")
  // Direct connection for migrations / introspection.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  tokenVersion Int             @default(0) // bumped to invalidate existing sessions
  unit         String          @default("kg")
  avatarUrl    String?
  goal         String?
  goalWeightKg Float?
  calorieGoal  Int?
  proteinGoal  Int?
  supplements  String? // CSV of supplement names tracked daily
  trainingDays String? // CSV of weekday numbers, 0=Sun .. 6=Sat, e.g. "1,3,5"
  reminderTime String          @default("18:00")
  remindersOn  Boolean         @default(false)
  timezone        String?      // IANA tz (e.g. "Asia/Kolkata") for local reminder time
  lastNotifiedDay String?      // YYYY-MM-DD of the last reminder sent, to dedupe
  onboardedAt  DateTime?
  createdAt    DateTime        @default(now())
  enrollments  Enrollment[]
  bodyMetrics  BodyMetric[]
  nutrition    NutritionEntry[]
  dailyLogs    DailyLog[]
  photos       ProgressPhoto[]
  following    Follow[]        @relation("follower")
  followers    Follow[]        @relation("following")
  resetTokens  PasswordResetToken[]
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model NutritionEntry {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day      String // YYYY-MM-DD (user-local)
  label    String
  calories Float    @default(0)
  proteinG Float    @default(0)
  carbsG   Float    @default(0)
  fatG     Float    @default(0)
  createdAt DateTime @default(now())

  @@index([userId, day])
}

model DailyLog {
  id               String @id @default(cuid())
  userId           String
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day              String // YYYY-MM-DD
  waterMl          Int    @default(0)
  supplementsTaken String @default("") // CSV of supplement names taken

  @@unique([userId, day])
  @@index([userId])
}

model BodyMetric {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     DateTime @default(now())
  weightKg Float?
  chestCm  Float?
  waistCm  Float?
  hipsCm   Float?
  armsCm   Float?
  thighsCm Float?
  bodyFat  Float?

  @@index([userId])
}

model ProgressPhoto {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date    DateTime @default(now())
  dataUrl String
  note    String?

  @@index([userId])
}

// Cache of resolved exercise demo media (from ExerciseDB) keyed by our cleaned
// exercise name, so each name is fetched at most once.
model ExerciseMedia {
  id        String   @id @default(cuid())
  nameKey   String   @unique
  gifUrl    String?
  found     Boolean  @default(false)
  fetchedAt DateTime @default(now())
}

// Cache of resolved Unsplash photos keyed by a stable slot key (e.g. "bg",
// "hero:chest"), so each slot fetches once and we stay within rate limits.
model PhotoCache {
  id        String   @id @default(cuid())
  queryKey  String   @unique
  url       String
  author    String?
  authorUrl String?
  fetchedAt DateTime @default(now())
}

model Plan {
  id          String       @id @default(cuid())
  name        String
  description String?
  totalWeeks  Int          @default(12)
  weeks       Week[]
  enrollments Enrollment[]
}

model Week {
  id     String       @id @default(cuid())
  planId String
  plan   Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  number Int
  style  String?
  days   WorkoutDay[]

  @@unique([planId, number])
}

model WorkoutDay {
  id         String           @id @default(cuid())
  weekId     String
  week       Week             @relation(fields: [weekId], references: [id], onDelete: Cascade)
  dayNumber  Int
  label      String
  focus      String
  orderIndex Int
  exercises  PlanExercise[]
  sessions   WorkoutSession[]
}

model PlanExercise {
  id           String     @id @default(cuid())
  workoutDayId String
  workoutDay   WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  name         String
  groupLabel   String?
  muscle       String
  orderIndex   Int
  warmupSets   Int        @default(0)
  workingSets  Int        @default(0)
  repTarget    String
  isCardio     Boolean    @default(false)
  setEntries   SetEntry[]

  @@index([workoutDayId])
}

model Enrollment {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  startDate DateTime         @default(now())
  status    String           @default("active")
  sessions  WorkoutSession[]
  swaps     ExerciseSwap[]

  @@unique([userId, planId])
}

model ExerciseSwap {
  id             String     @id @default(cuid())
  enrollmentId   String
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  planExerciseId String
  name           String

  @@unique([enrollmentId, planExerciseId])
}

model WorkoutSession {
  id            String       @id @default(cuid())
  enrollmentId  String
  enrollment    Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  workoutDayId  String
  workoutDay    WorkoutDay   @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  performedDate DateTime     @default(now())
  status        String       @default("in_progress")
  notes         String?
  mood          String?
  bodyweight    Float?
  setEntries    SetEntry[]

  @@unique([enrollmentId, workoutDayId])
  @@index([enrollmentId, performedDate])
}

model SetEntry {
  id             String         @id @default(cuid())
  sessionId      String
  session        WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  planExerciseId String
  planExercise   PlanExercise   @relation(fields: [planExerciseId], references: [id], onDelete: Cascade)
  setNumber      Int
  setType        String
  weight         Float?
  reps           Int?
  rpe            Float?
  done           Boolean        @default(false)

  @@unique([sessionId, planExerciseId, setNumber])
  @@index([planExerciseId])
}
